# "development" (default, safe for local work) or "production".
# Setting this to "production" turns on startup checks that refuse to boot
# with an insecure/default JWT secret, and makes `python -m app.seed` refuse
# to run (use `python -m app.create_superadmin` instead in production).
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://cab_user:cab_password@localhost:5433/cancer_aware_bharat
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO

# "local" (default) writes uploaded patient reports to UPLOAD_DIR on this
# machine's disk -- fine for dev/tests, but most container platforms wipe
# the filesystem on every deploy and a multi-instance deployment only ever
# sees whatever landed on that one instance. Set to "s3" before real patient
# volume; works against AWS S3, Cloudflare R2, MinIO, or your platform's own
# blob storage. Credentials go through boto3's own standard env vars
# (AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY) or an IAM role -- not here.
STORAGE_BACKEND=local
# Required if STORAGE_BACKEND=s3.
# S3_BUCKET=cancer-aware-bharat-reports
# S3_REGION=ap-south-1
# Only set for a non-AWS S3-compatible endpoint (R2, MinIO, etc.); leave
# unset against real AWS S3.
# S3_ENDPOINT_URL=https://<account-id>.r2.cloudflarestorage.com

# Only set to true when this app sits behind a reverse proxy/load balancer
# that itself sets X-Forwarded-For (e.g. nginx, an ALB) -- otherwise rate
# limiting keys on the proxy's IP for every request instead of the real
# client. Leave false for direct/local deployments.
TRUST_PROXY_HEADERS=false

# "console" (default) logs emails (admin-account temp passwords, hospital
# approval credentials, patient OTP codes) instead of sending them -- fine
# for dev. Set to "smtp" and fill in the fields below to send real email
# through a mailbox or a transactional-email service (SendGrid, SES, etc. --
# anything that speaks SMTP).
EMAIL_BACKEND=console
# Required if EMAIL_BACKEND=smtp.
# SMTP_HOST=smtp.sendgrid.net
# SMTP_PORT=587
# SMTP_USERNAME=apikey
# SMTP_PASSWORD=your-real-smtp-password-or-api-key
# SMTP_FROM_EMAIL=noreply@yourdomain.org
# SMTP_USE_TLS=true

# Razorpay checkout for public donations (see /donations/checkout and
# /donations/verify). Both unset by default -- those endpoints return 503
# until real keys are set. Use TEST mode keys (rzp_test_...) until you're
# ready to accept real money.
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=your-real-razorpay-key-secret
