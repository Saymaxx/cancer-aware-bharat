# "development" (default, safe for local work) or "production".
# Setting this to "production" turns on startup checks that refuse to boot
# with an insecure/default JWT secret, and makes `python -m app.seed` refuse
# to run (use `python -m app.create_superadmin` instead in production).
ENVIRONMENT=development

DATABASE_URL=postgresql+psycopg://cab_user:cab_password@localhost:5433/cancer_aware_bharat
JWT_SECRET_KEY=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000,http://localhost:5173
UPLOAD_DIR=./uploads
LOG_LEVEL=INFO
